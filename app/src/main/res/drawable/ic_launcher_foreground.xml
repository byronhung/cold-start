<?xml version="1.0" encoding="utf-8"?>
<!--
  First Light icon, "Horizon": the sun half risen over the horizon, five rays, and its reflection
  on the water. The sun and rays sit inside the adaptive-icon safe zone (66dp circle at the centre
  of 108dp); only the ends of the horizon line run past it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- the sun, half risen -->
    <path
        android:fillColor="#FFFFE1B0"
        android:pathData="M34,72 A20,20 0 0,1 74,72 Z" />
    <!-- five rays -->
    <path
        android:pathData="M31.5,59 L24.6,55 M41,49.5 L37,42.6 M54,46 L54,38 M67,49.5 L71,42.6 M76.5,59 L83.4,55"
        android:strokeWidth="3"
        android:strokeColor="#FFFFE1B0"
        android:strokeLineCap="round" />
    <!-- the horizon -->
    <path
        android:pathData="M20,72 L88,72"
        android:strokeWidth="2"
        android:strokeColor="#FFFFE1B0"
        android:strokeLineCap="round" />
    <!-- its reflection on the water -->
    <path
        android:pathData="M45,78 L63,78 M49,84 L59,84"
        android:strokeWidth="2"
        android:strokeColor="#80FFE1B0"
        android:strokeLineCap="round" />
</vector>
