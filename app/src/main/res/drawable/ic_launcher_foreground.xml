<?xml version="1.0" encoding="utf-8"?>
<!--
  First Light logo. A power symbol that is also a clock face: the line is the hour hand at 12,
  the ring is the dial. Underneath, the ringing screen's round pips: two done, one to go.
  Drawn inside the adaptive-icon safe zone (66dp circle at the centre of 108dp).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- the dial: a ring with its top open -->
    <path
        android:pathData="M64.9,34.44 A19,19 0 1,1 43.1,34.44"
        android:strokeWidth="6"
        android:strokeColor="#3FCFB4"
        android:strokeLineCap="round" />
    <!-- the hand, pointing at 12 -->
    <path
        android:pathData="M54,26 L54,47"
        android:strokeWidth="6"
        android:strokeColor="#3FCFB4"
        android:strokeLineCap="round" />
    <!-- hour ticks at 3, 6 and 9: what makes the power symbol a clock -->
    <path
        android:pathData="M64.5,50 L67.5,50 M54,60.5 L54,63.5 M40.5,50 L43.5,50"
        android:strokeWidth="2.5"
        android:strokeColor="#8C3FCFB4"
        android:strokeLineCap="round" />
    <!-- round pips: done, done, to go -->
    <path
        android:fillColor="#3FCFB4"
        android:pathData="M41,77h4a2,2 0,0 1,0 4h-4a2,2 0,0 1,0 -4z" />
    <path
        android:fillColor="#3FCFB4"
        android:pathData="M52,77h4a2,2 0,0 1,0 4h-4a2,2 0,0 1,0 -4z" />
    <path
        android:fillColor="#77839A"
        android:pathData="M63,77h4a2,2 0,0 1,0 4h-4a2,2 0,0 1,0 -4z" />
</vector>
